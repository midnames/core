# Local Midnight environment (bench/local-env.yml) — NOT secrets.
# Bench-only mnemonic, funded from genesis via midnight-local-network's
# `yarn fund-and-register-dust`. Chosen so the HKDF-derived issuer P-256 key
# has x,y inside the BLS12-381 scalar field (deployDid requires it; ~20% of
# random seeds qualify).
MIDNIGHT_NETWORK_ID=undeployed
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
MIDNIGHT_NODE_URL=http://127.0.0.1:9944
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
MIDNIGHT_WALLET_SEED="apart bundle pencil any canoe coyote tortoise renew pumpkin easy sunny stuff"
API_KEY=bench-m6-secret
MIDNIGHT_REVOCATION_CONTRACT_ADDRESS=b4334b0e76000ec6a491c27bde116843eb4d32bcc5526cbe730ef8fecc9c1e71
