{
  "name": "midnames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build:vc": "pnpm --filter @midnames/vc build",
    "typecheck:vc": "pnpm --filter @midnames/vc typecheck",
    "build:utils": "pnpm --filter @midnames/utils build",
    "build:compact": "pnpm --filter @midnames/core compact",
    "build:contract": "pnpm --filter @midnames/core build",
    "build:cli": "pnpm --filter @midnames/cli build",
    "build:legacy": "pnpm run build:utils && pnpm run build:compact && pnpm run build:contract && pnpm run build:cli",
    "clean": "pnpm -r run clean && rm -rf node_modules/.cache",
    "typecheck": "pnpm run build:utils && pnpm -r run typecheck",
    "test": "pnpm run build:utils && pnpm -r run test",
    "check": "pnpm run typecheck && pnpm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@eslint/js": "^9.26.0",
    "@types/node": "24.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.0.0",
    "testcontainers": "11.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@midnames/vc": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "^0.8.1",
    "@midnight-ntwrk/ledger": "^4.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "2.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-types": "2.0.1",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-api": "5.0.0",
    "@midnight-ntwrk/zswap": "^4.0.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.1"
  }
}
